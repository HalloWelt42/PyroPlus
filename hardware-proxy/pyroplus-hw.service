[Unit]
Description=PyroPlus Hardware-Proxy (GPIO, I2C, SPI)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pyroplus-hw
ExecStart=/opt/pyroplus-hw/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
