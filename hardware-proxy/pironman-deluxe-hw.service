[Unit]
Description=PironMan Deluxe Hardware-Proxy
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pironman-deluxe-hw
ExecStart=/opt/pironman-deluxe-hw/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
